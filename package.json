{
  "name": "ore-meshi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js generate",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:seed": "node --env-file=.env.local --import tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "analytics:verify": "node --env-file=.env.local --import tsx scripts/verify-snapshot-parity.ts",
    "db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
