{
  "name": "ore-meshi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js generate",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:seed": "node --env-file=.env.local --import tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "test:e2e:billing": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test --config=playwright.billing.config.ts",
    "test:e2e:isolated": "node --env-file=.env.local e2e/run-isolated.mjs",
    "test:e2e:ui": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:install": "playwright install chromium",
    "analytics:verify": "node --env-file=.env.local --import tsx scripts/verify-snapshot-parity.ts",
    "analytics:backfill": "node --env-file=.env.local --import tsx scripts/backfill-daily-metrics.ts",
    "test:accounts": "node --env-file=.env.local --import tsx scripts/create-test-accounts.ts",
    "db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:deploy:e2e": "node --env-file-if-exists=.env.local scripts/e2e-db-deploy.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google-cloud/storage": "^8.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^7.10.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/nodemailer": "^8.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "imapflow": "^2.2.5",
    "lucide-react": "^1.51.0",
    "mailparser": "^3.9.35",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "sanitize-html": "^2.18.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prisma": "^5.22.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
