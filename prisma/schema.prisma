model GrowthEvent {
  id            String          @id @default(cuid())
  sessionKey    String
  userId        String?
  eventType     GrowthEventType
  recruitmentId String?
  area          String?
  foodCategory  String?
  loggedIn      Boolean         @default(false)
  source        String?
  referrer      String?
  shareType     String?
  // utm_source は既存の source を再利用する(重複カラムを避けるため)。utm_medium/utm_campaignのみ追加。
  utmMedium     String?
  utmCampaign   String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  @@index([eventType, createdAt])
  @@index([sessionKey, createdAt])
  @@index([recruitmentId])
  @@index([utmCampaign, createdAt])
}

enum JoinIntentStatus {
  PENDING
  RESTORED
  COMPLETED
  EXPIRED
}

model JoinIntent {
  id           String           @id @default(cuid())
  token        String           @unique
  mealId       String
  source       String?
  referrer     String?
  referralCode String?
  sessionKey   String
  userId       String?
  status       JoinIntentStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  meal         Meal             @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId, status])
  @@index([expiresAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  mealId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([userId, mealId])
  @@index([mealId])
}

model Referral {
  id             String    @id @default(cuid())
  referralCode   String
  referrerUserId String
  referredUserId String?
  mealId         String?
  source         String?
  createdAt      DateTime  @default(now())
  convertedAt    DateTime?
  activatedAt    DateTime?
  referrer       User      @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred       User?     @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([referralCode])
  @@index([referrerUserId])
  @@index([referredUserId])
}

enum NotificationType {
  JOIN_REQUEST_RECEIVED
  JOIN_REQUEST_ACCEPTED
  MEAL_MATCHED
  LAST_SLOT_REACHED
  DEADLINE_SOON
  MEAL_TODAY
  MEAL_STARTING_SOON
  DEMAND_CLUSTER_READY
  DEMAND_MATCH_FOUND
  MEAL_COMPLETION_CHECK
  MEAL_AUTO_CLOSED
}

enum NotificationCategory {
  RECRUITMENT
  PARTICIPATION
  RECOMMENDATION
}

model Notification {
  id             String               @id @default(cuid())
  userId         String
  type           NotificationType
  category       NotificationCategory
  title          String
  body           String
  mealId         String?
  dedupeKey      String               @unique
  readAt         DateTime?
  clickedAt      DateTime?
  emailSentAt    DateTime?
  emailFailedAt  DateTime?
  emailClickedAt DateTime?
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type, createdAt])
}

model NotificationPreference {
  userId                    String   @id
  recruitmentEnabled        Boolean  @default(true)
  participationEnabled      Boolean  @default(true)
  recommendationEnabled     Boolean  @default(true)
  // トランザクション通知(参加承認/成立/Demand一致/当日等)と、マーケティング寄りの通知(おすすめ等)のメール可否を区別する。
  emailTransactionalEnabled Boolean  @default(true)
  emailMarketingEnabled     Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsSnapshot {
  id            String                @id @default(cuid())
  snapshotType  AnalyticsSnapshotType
  asOfDate      DateTime              @db.Date
  windowDays    Int
  timezone      String                @default("Asia/Tokyo")
  periodStart   DateTime
  periodEnd     DateTime
  schemaVersion Int                   @default(1)
  payload       Json
  generatedAt   DateTime
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([snapshotType, asOfDate, windowDays, schemaVersion])
  @@index([snapshotType, generatedAt])
}

model DailyMetrics {
  id                       String   @id @default(cuid())
  date                     DateTime @db.Date
  timezone                 String   @default("Asia/Tokyo")
  periodStart              DateTime
  periodEnd                DateTime
  signupStarted            Int      @default(0)
  signupCompleted          Int      @default(0)
  joinIntentCreated        Int      @default(0)
  joinAfterSignupCompleted Int      @default(0)
  recruitmentShareX        Int      @default(0)
  recruitmentShareLine     Int      @default(0)
  recruitmentUrlCopied     Int      @default(0)
  referralOpened           Int      @default(0)
  referralSignupCompleted  Int      @default(0)
  quickPostStarted         Int      @default(0)
  quickPostCompleted       Int      @default(0)
  mealsCreated             Int      @default(0)
  mealsMatched             Int      @default(0)
  matchesCompleted         Int      @default(0)
  uniqueDiners             Int      @default(0)
  demandIntentsCreated     Int      @default(0)
  demandIntentsMatched     Int      @default(0)
  demandRecruitments       Int      @default(0)
  demandMealsMatched       Int      @default(0)
  notificationsSent        Int      @default(0)
  notificationsOpened      Int      @default(0)
  notificationsClicked     Int      @default(0)
  notificationTypeMetrics  Json     @default("{}")
  generatedAt              DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([date, timezone])
  @@index([date])
}

model AreaDemandStats {
  id                    String   @id @default(cuid())
  date                  DateTime @db.Date
  timezone              String   @default("Asia/Tokyo")
  periodStart           DateTime
  periodEnd             DateTime
  area                  String
  genre                 String   @default("未指定")
  demandIntents         Int      @default(0)
  mealsCreated          Int      @default(0)
  mealsMatched          Int      @default(0)
  matchesCompleted      Int      @default(0)
  estimatedParticipants Int      @default(0)
  generatedAt           DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date, timezone, area, genre])
  @@index([area, date])
  @@index([area, genre, date])
}

model HourlyDemandStats {
  id               String   @id @default(cuid())
  bucketStart      DateTime
  timezone         String   @default("Asia/Tokyo")
  localDate        DateTime @db.Date
  localWeekday     Int
  localHour        Int
  area             String
  genre            String   @default("未指定")
  demandIntents    Int      @default(0)
  mealsCreated     Int      @default(0)
  mealsMatched     Int      @default(0)
  matchesCompleted Int      @default(0)
  generatedAt      DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([bucketStart, timezone, area, genre])
  @@index([localDate, area])
  @@index([localWeekday, localHour, area, genre])
}

enum DemandIntentStatus {
  ACTIVE
  MATCHED
  EXPIRED
  CANCELLED
}

model DemandIntent {
  id               String             @id @default(cuid())
  userId           String
  area             String
  genre            String?
  timeRange        String?
  desiredGroupSize Int                @default(2)
  status           DemandIntentStatus @default(ACTIVE)
  // 実際に参加した募集への軽量な参照(Meal.demandClusterKeyと同様、FK制約は持たせない)。
  matchedMealId    String?
  createdAt        DateTime           @default(now())
  expiresAt        DateTime
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([area, genre, status, createdAt])
  @@index([status, expiresAt])
  @@index([userId])
}

model UserRecommendationProfile {
  userId           String   @id
  genreWeights     Json     @default("{}")
  areaWeights      Json     @default("{}")
  groupSizeWeights Json     @default("{}")
  timeWeights      Json     @default("{}")
  sampleSize       Int      @default(0)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingCustomer {
  id                String          @id @default(cuid())
  businessAccountId String          @unique
  stripeCustomerId  String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
}

model BusinessSubscription {
  id                   String             @id @default(cuid())
  businessAccountId    String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  plan                 BusinessPlan
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  businessAccount      BusinessAccount    @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
}

model SponsorOrder {
  id                      String             @id @default(cuid())
  businessAccountId       String
  campaignId              String
  orderType               OrderType
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?            @unique
  stripePriceId           String
  amount                  Int?
  currency                String?
  status                  SponsorOrderStatus @default(DRAFT)
  paidAt                  DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  businessAccount         BusinessAccount    @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)

  @@index([businessAccountId, createdAt])
  @@index([orderType, campaignId, status])
  @@index([status, paidAt])
}

// エリア×ジャンル単位の期間限定スポンサー掲載。既存のSponsorOrder/OrderType.AREA_FEATURED/
// STRIPE_PRICE_AREA_FEATURED(既存のconfig.tsで定義済み)をそのまま再利用する。
model AreaSponsorship {
  id                String                 @id @default(cuid())
  businessAccountId String
  area              String
  genre             String?
  startsAt          DateTime
  endsAt            DateTime
  status            BusinessCampaignStatus @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  businessAccount   BusinessAccount        @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)

  @@index([area, genre, status])
  @@index([status, endsAt])
  @@index([businessAccountId, createdAt])
}

model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
}

model BusinessMember {
  businessAccountId String
  userId            String
  role              BusinessMemberRole @default(STAFF)
  canPostToSocial   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  businessAccount   BusinessAccount    @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([businessAccountId, userId])
  @@index([userId])
}

model SponsoredMeal {
  id                String                 @id @default(cuid())
  businessAccountId String
  mealId            String?
  title             String
  sponsorName       String
  restaurantName    String
  area              String
  genre             String?
  startsAt          DateTime
  participantLimit  Int
  remainingSlots    Int
  benefit           String
  description       String                 @default("")
  status            BusinessCampaignStatus @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  businessAccount   BusinessAccount        @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  meal              Meal?                  @relation(fields: [mealId], references: [id], onDelete: SetNull)

  @@index([businessAccountId, status, startsAt])
  @@index([mealId])
}

model SponsorCampaign {
  id                String                 @id @default(cuid())
  businessAccountId String
  title             String
  sponsorName       String
  restaurantName    String
  area              String
  startsAt          DateTime
  participantLimit  Int
  remainingSlots    Int
  benefit           String
  status            BusinessCampaignStatus @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  businessAccount   BusinessAccount        @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)

  @@index([businessAccountId, status, startsAt])
}

model SeatCampaign {
  id                String                 @id @default(cuid())
  businessAccountId String
  restaurantName    String
  area              String
  remainingSeats    Int
  endsAt            DateTime
  benefit           String
  description       String                 @default("")
  status            BusinessCampaignStatus @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  businessAccount   BusinessAccount        @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)

  @@index([businessAccountId, status, endsAt])
}

model Coupon {
  id                String                 @id @default(cuid())
  businessAccountId String
  title             String
  restaurantName    String
  area              String
  benefit           String
  expiresAt         DateTime
  status            BusinessCampaignStatus @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  businessAccount   BusinessAccount        @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  redemptions       CouponRedemption[]

  @@index([businessAccountId, status, expiresAt])
}

model CouponRedemption {
  id                String          @id @default(cuid())
  couponId          String
  businessAccountId String
  userId            String
  redeemedAt        DateTime        @default(now())
  coupon            Coupon          @relation(fields: [couponId], references: [id], onDelete: Cascade)
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([businessAccountId, redeemedAt])
  @@index([userId, redeemedAt])
}

model DirectAdCampaign {
  id                String                 @id @default(cuid())
  businessAccountId String
  title             String
  advertiserName    String
  description       String
  startsAt          DateTime
  endsAt            DateTime
  status            BusinessCampaignStatus @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  businessAccount   BusinessAccount        @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)

  @@index([businessAccountId, status, endsAt])
}

model BusinessSocialAccount {
  id                String                      @id @default(cuid())
  businessAccountId String
  provider          SocialProvider
  providerAccountId String
  username          String
  displayName       String
  profileImageUrl   String?
  status            SocialConnectionStatus      @default(DISCONNECTED)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  businessAccount   BusinessAccount             @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  settings          BusinessSocialPostSetting[]
  posts             SocialPost[]

  @@unique([provider, providerAccountId])
  @@index([businessAccountId, status])
}

model BusinessSocialPostSetting {
  id                       String                 @id @default(cuid())
  businessAccountId        String
  socialAccountId          String?
  autoPostSponsoredMeal    Boolean                @default(false)
  autoPostSeatCampaign     Boolean                @default(false)
  autoPostCancellationSlot Boolean                @default(false)
  autoPostLastSeat         Boolean                @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  businessAccount          BusinessAccount        @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  socialAccount            BusinessSocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@unique([businessAccountId])
  @@index([socialAccountId])
}

model SocialPost {
  id                String                 @id @default(cuid())
  businessAccountId String
  socialAccountId   String?
  entityType        SocialEntityType
  entityId          String
  postType          SocialPostType
  status            SocialPostStatus       @default(PENDING)
  shareMode         SocialShareMode        @default(MANUAL)
  idempotencyKey    String                 @unique
  externalPostId    String?
  postedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  businessAccount   BusinessAccount        @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  socialAccount     BusinessSocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  referralEvents    ReferralEvent[]

  @@index([businessAccountId, createdAt])
  @@index([entityType, entityId])
}

model ReferralEvent {
  id                 String            @id @default(cuid())
  businessAccountId  String
  socialPostId       String?
  entityType         SocialEntityType?
  entityId           String?
  eventType          ReferralEventType
  sourceEventId      String?
  conversionEntityId String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  anonymousId        String?
  createdAt          DateTime          @default(now())
  businessAccount    BusinessAccount   @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  socialPost         SocialPost?       @relation(fields: [socialPostId], references: [id], onDelete: SetNull)

  @@index([businessAccountId, eventType, createdAt])
  @@index([socialPostId, eventType])
  @@index([sourceEventId])
  @@index([conversionEntityId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Meal {
  id               String      @id @default(cuid())
  hostId           String
  title            String
  description      String?
  area             String
  restaurant       String?
  genre            String?
  alcohol          String?
  smoking          String?
  ageCondition     String?
  deadline         DateTime?
  budgetMin        Int
  budgetMax        Int
  paymentType      PaymentType
  maxParticipants  Int
  status           MealStatus  @default(OPEN)
  firstJoinAt      DateTime?
  matchedAt        DateTime?
  demandClusterKey String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  host           User                  @relation("MealHost", fields: [hostId], references: [id], onDelete: Cascade)
  candidates     MealCandidate[]
  joinRequests   JoinRequest[]
  matches        Match[]
  purposes       MealPurposeRelation[]
  sponsoredMeals SponsoredMeal[]
  joinIntents    JoinIntent[]
  favorites      Favorite[]

  @@index([hostId, createdAt])
  @@index([status, area, createdAt])
  @@index([area, genre, status])
  @@index([createdAt, status])
  @@index([matchedAt])
}

model DiningType {
  id        String           @id @default(cuid())
  slug      String           @unique
  label     String
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  users     UserDiningType[]

  @@index([isActive, sortOrder])
}

model UserDiningType {
  userId       String
  diningTypeId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  diningType   DiningType @relation(fields: [diningTypeId], references: [id], onDelete: Cascade)

  @@id([userId, diningTypeId])
  @@index([diningTypeId])
}

model MealPurpose {
  id        String                @id @default(cuid())
  slug      String                @unique
  label     String
  sortOrder Int                   @default(0)
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  meals     MealPurposeRelation[]

  @@index([isActive, sortOrder])
}

model MealPurposeRelation {
  mealId    String
  purposeId String
  meal      Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  purpose   MealPurpose @relation(fields: [purposeId], references: [id], onDelete: Cascade)

  @@id([mealId, purposeId])
  @@index([purposeId])
}

// 都道府県+主要都市の候補データ(全市区町村ではなく政令指定都市・県庁所在地・主要観光/繁華エリア等)。
// Meal.area / SponsoredMeal.area等の自由入力欄はそのまま(丁目・商店街名などの追記も可能)で、
// 入力補助のsuggestion一覧としてのみ使う(外部キーではない)。
model AreaOption {
  id         String   @id @default(cuid())
  prefecture String
  city       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([prefecture, city])
  @@index([isActive, sortOrder])
}

model MealCandidate {
  id        String   @id @default(cuid())
  mealId    String
  date      DateTime
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  meal         Meal          @relation(fields: [mealId], references: [id], onDelete: Cascade)
  joinRequests JoinRequest[]
  matches      Match[]

  @@index([mealId])
}

model JoinRequest {
  id          String            @id @default(cuid())
  mealId      String
  userId      String
  candidateId String
  message     String?
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  meal      Meal          @relation(fields: [mealId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate MealCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([mealId, userId], map: "join_request_unique_per_user_per_meal")
  @@index([mealId, status])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model Match {
  id          String      @id @default(cuid())
  mealId      String      @unique
  candidateId String
  scheduledAt DateTime
  status      MatchStatus @default(ACTIVE)
  // COMPLETEDへの遷移時刻。Meal.matchedAt(必要人数到達)とは別概念で、実際に開催が確認された時刻。
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  meal                Meal                 @relation(fields: [mealId], references: [id], onDelete: Cascade)
  candidate           MealCandidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  participants        MatchParticipant[]
  rescheduleProposals RescheduleProposal[]
  diningFeedbacks     DiningFeedback[]

  @@index([mealId, status])
  @@index([candidateId])
  @@index([status, scheduledAt])
  @@index([status, completedAt])
}

model MatchParticipant {
  matchId   String
  userId    String
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
  @@index([userId])
}

model RescheduleProposal {
  id         String                   @id @default(cuid())
  matchId    String
  proposerId String
  proposedAt DateTime
  status     RescheduleProposalStatus @default(PENDING)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  votes    RescheduleVote[]
  match    Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  proposer User             @relation("RescheduleProposer", fields: [proposerId], references: [id], onDelete: Cascade)

  @@index([matchId, status])
  @@index([proposerId, status])
}

model DiningFeedback {
  id               String           @id @default(cuid())
  matchId          String
  fromUserId       String
  toUserId         String
  wouldMeetAgain   WouldMeetAgain
  attendanceStatus AttendanceStatus @default(ATTENDED)
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  from  User  @relation("DiningFeedbackFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to    User  @relation("DiningFeedbackTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([matchId, fromUserId, toUserId], map: "dining_feedback_unique_per_match_user_pair")
  @@index([matchId])
  @@index([fromUserId])
  @@index([toUserId])
}

model RescheduleVote {
  proposalId String
  userId     String
  createdAt  DateTime           @default(now())
  proposal   RescheduleProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([proposalId, userId])
  @@index([userId])
}
