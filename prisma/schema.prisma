model User {
  id                    String    @id @default(cuid())
  email                 String?   @unique
  emailVerified         DateTime?
  twitterId             String    @unique
  twitterUsername       String
  displayName           String
  image                 String?
  bio                   String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  isAdmin               Boolean   @default(false)
  preferredArea         String?
  preferredGenres       String[]  @default([])
  onboardingCompletedAt DateTime?
  referralCode          String?   @unique

  favorites              Favorite[]
  referralsGiven         Referral[]                 @relation("ReferralReferrer")
  referralsReceived      Referral[]                 @relation("ReferralReferred")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  demandIntents          DemandIntent[]
  recommendationProfile  UserRecommendationProfile?
  accounts               Account[]
  sessions               Session[]
  hostedMeals            Meal[]                     @relation("MealHost")
  joinRequests           JoinRequest[]
  rescheduleVotes        RescheduleVote[]
  matchParticipants      MatchParticipant[]
  rescheduleProposals    RescheduleProposal[]       @relation("RescheduleProposer")
  diningFeedbackSent     DiningFeedback[]           @relation("DiningFeedbackFrom")
  diningFeedbackReceived DiningFeedback[]           @relation("DiningFeedbackTo")
  diningTypes            UserDiningType[]
  businessMemberships    BusinessMember[]
  couponRedemptions      CouponRedemption[]
  assignedBusinessLeads  BusinessLead[]             @relation("AssignedBusinessLead")
  businessLeadNotes      BusinessLeadNote[]

  @@index([twitterUsername])
}

model BusinessAccount {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  area         String?
  legalName    String?
  businessType BusinessType          @default(RESTAURANT)
  contactName  String?
  contactEmail String?
  websiteUrl   String?
  consultation String?
  purposes     String[]              @default([])
  planOverride BusinessPlan?
  status       BusinessAccountStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  members            BusinessMember[]
  sponsoredMeals     SponsoredMeal[]
  sponsorCampaigns   SponsorCampaign[]
  seatCampaigns      SeatCampaign[]
  coupons            Coupon[]
  directAdCampaigns  DirectAdCampaign[]
  socialAccounts     BusinessSocialAccount[]
  socialPostSettings BusinessSocialPostSetting[]
  socialPosts        SocialPost[]
  referralEvents     ReferralEvent[]
  billingCustomer    BillingCustomer?
  subscription       BusinessSubscription?
  sponsorOrders      SponsorOrder[]
  couponRedemptions  CouponRedemption[]
  convertedLeads     BusinessLead[]
  referralsSent      BusinessReferral[]          @relation("BusinessReferralReferrer")
  referralReceived   BusinessReferral?           @relation("BusinessReferralReferred")
  partnerMemberships PartnerCampaignMember[]
  marketingEvents    BusinessMarketingEvent[]
  areaSponsorships   AreaSponsorship[]
}

model BusinessLead {
  id                  String                   @id @default(cuid())
  companyName         String
  contactName         String
  email               String
  phone               String?
  websiteUrl          String?
  businessType        BusinessType
  area                String
  purpose             String
  monthlyBudgetRange  String?
  desiredStartDate    DateTime?
  message             String
  source              LeadSource               @default(DIRECT)
  status              LeadStatus               @default(NEW)
  assignedAdminId     String?
  businessAccountId   String?
  referralCode        String?
  partnerCampaignId   String?
  downloadRequestedAt DateTime?
  internalNote        String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  assignedAdmin       User?                    @relation("AssignedBusinessLead", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  businessAccount     BusinessAccount?         @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  partnerCampaign     PartnerCampaign?         @relation(fields: [partnerCampaignId], references: [id], onDelete: SetNull)
  notes               BusinessLeadNote[]
  marketingEvents     BusinessMarketingEvent[]

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([email])
  @@index([businessAccountId])
}

model BusinessLeadNote {
  id          String       @id @default(cuid())
  leadId      String
  adminUserId String
  note        String
  createdAt   DateTime     @default(now())
  lead        BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  adminUser   User         @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([adminUserId])
}

enum SalesCandidateStatus {
  NEW
  CONTACT_READY
  CONTACTED
  REPLIED
  INTERESTED
  REGISTERED
  DECLINED
  DO_NOT_CONTACT
}

// BusinessLeadは「問い合わせフォーム経由で先方から接触してきた」ことを表すインバウンド専用モデルで、
// email/messageが必須のため、まだこちらから声をかけていない営業候補を無理にBusinessLeadとして
// 作ると必須項目を捏造することになる。そのため別モデルとして持つ(Opportunity Ranking発の
// アウトバウンド候補専用)。実在店舗が判明した場合のみstoreNameを埋める運用を想定。
model SalesCandidate {
  id               String               @id @default(cuid())
  area             String
  genre            String
  // 特定の実在店舗が判明していない(エリア×ジャンル単位の候補)場合は空文字列を使う。
  // NULLABLEにするとPostgresの一意制約でNULL同士が別行扱いになり重複生成を防げなくなるため。
  storeName        String               @default("")
  opportunityScore Float
  status           SalesCandidateStatus @default(NEW)
  lastContactedAt  DateTime?
  contactCount     Int                  @default(0)
  memo             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([area, genre, storeName])
  @@index([status, opportunityScore])
}

enum SocialContentStatus {
  DRAFT
  APPROVED
  POSTED
}

enum SocialContentChannel {
  X
  INSTAGRAM
  TIKTOK
  THREADS
}

// SocialPostは店舗キャンペーン専用(businessAccountId必須)のため転用せず、
// サービス全体・匿名集計値ベースのGrowthコンテンツ案は別モデルとして持つ。
// 自動投稿APIとは連携せず、コピーして手動投稿する運用を前提とする(DRAFT→APPROVED→POSTEDは手動遷移)。
model SocialContentDraft {
  id        String               @id @default(cuid())
  channel   SocialContentChannel
  body      String
  status    SocialContentStatus  @default(DRAFT)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}

model FirstTimeOffer {
  id                    String        @id @default(cuid())
  name                  String
  offerType             OfferType
  discountPercent       Int?
  discountAmount        Int?
  targetProduct         TargetProduct
  stripePromotionCodeId String?
  startsAt              DateTime
  endsAt                DateTime
  maxUses               Int?
  usedCount             Int           @default(0)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([targetProduct, isActive, startsAt, endsAt])
}

model BusinessReferral {
  id                        String               @id @default(cuid())
  referrerBusinessAccountId String
  referralCode              String               @unique
  referredBusinessAccountId String?              @unique
  status                    ReferralStatus       @default(INVITED)
  rewardStatus              ReferralRewardStatus @default(PENDING)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  referrerBusinessAccount   BusinessAccount      @relation("BusinessReferralReferrer", fields: [referrerBusinessAccountId], references: [id], onDelete: Cascade)
  referredBusinessAccount   BusinessAccount?     @relation("BusinessReferralReferred", fields: [referredBusinessAccountId], references: [id], onDelete: SetNull)

  @@index([referrerBusinessAccountId, status])
}

model PartnerCampaign {
  id             String                  @id @default(cuid())
  slug           String                  @unique
  title          String
  description    String
  area           String
  startsAt       DateTime
  endsAt         DateTime
  maxPartners    Int?
  joinedPartners Int                     @default(0)
  offerText      String
  status         PartnerCampaignStatus   @default(DRAFT)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  members        PartnerCampaignMember[]
  leads          BusinessLead[]

  @@index([status, startsAt, endsAt])
}

model PartnerCampaignMember {
  partnerCampaignId String
  businessAccountId String
  joinedAt          DateTime        @default(now())
  partnerCampaign   PartnerCampaign @relation(fields: [partnerCampaignId], references: [id], onDelete: Cascade)
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)

  @@id([partnerCampaignId, businessAccountId])
  @@index([businessAccountId])
}

model BusinessMarketingEvent {
  id                String                     @id @default(cuid())
  sessionKey        String
  businessAccountId String?
  leadId            String?
  eventType         BusinessMarketingEventType
  source            String?
  medium            String?
  campaign          String?
  content           String?
  createdAt         DateTime                   @default(now())
  businessAccount   BusinessAccount?           @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  lead              BusinessLead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([sessionKey, createdAt])
  @@index([businessAccountId, eventType])
  @@index([leadId])
}

