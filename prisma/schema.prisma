  ACCEPTED
  REJECTED
  CANCELLED
}

enum MatchStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RescheduleProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum WouldMeetAgain {
  YES
  NEUTRAL
